@using global::src.Controller
<li class="ControllerInfoView">
@if (ControllerInfo is null)
{
    <div>Loading…</div>
}
else
{
    <div class="controller-info" @onclick="HandleClick">
        <div class="controller-name">@ControllerInfo.Name</div>
        <div class="controller-ip">@ControllerInfo.Address</div>
    </div>
}
</li>
@code {
    [Parameter]
    public ControllerInfo ControllerInfo { get; set; } = default!;

    [Parameter]
    public EventCallback<ControllerInfo> OnClick { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(ControllerInfo);
    }
}
